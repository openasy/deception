{
  "openapi": "3.1.1",
  "info": {
    "title": "OpenAsy Deception API",
    "version": "0.1.0",
    "summary": "Canaries only an attacker would touch, and every time one was.",
    "description": "Every screen of deception uses this API, and so can your scripts and pipelines (ADR 0014). Within `/api/v1` changes are additive only; anything removed is deprecated first (ADR 0024). Errors use Problem Details (RFC 9457).\n\nCanary URLs are `/c/<token>`, outside the API: they answer a transparent GIF to anyone, for any path, and keep a trigger when the token is a canary's. Send CloudTrail events with `DECEPTION_INGEST_TOKEN`. Everything else takes the session of a signed-in person or an API token, and each operation names the role it needs (`x-openasy-role`: viewer, editor, admin; ADR 0003).\n\nSign-in, members and API tokens are under `/api/v1/auth`, provided by [@openasy/auth](https://github.com/openasy/auth#routes).",
    "license": {
      "name": "AGPL-3.0-only",
      "identifier": "AGPL-3.0-only"
    }
  },
  "servers": [
    {
      "url": "/",
      "description": "This deception"
    }
  ],
  "tags": [
    {
      "name": "Canaries",
      "description": "Tripwires and their bait."
    },
    {
      "name": "Triggers",
      "description": "Each use of a canary, and what a person says it was."
    },
    {
      "name": "CloudTrail",
      "description": "AWS key canaries are found in CloudTrail events."
    },
    {
      "name": "Product",
      "description": "Version and overview of this deception."
    }
  ],
  "paths": {
