    "/api/v1/cloudtrail": {
      "post": {
        "operationId": "sendCloudTrail",
        "tags": [
          "CloudTrail"
        ],
        "summary": "Send CloudTrail events",
        "security": [
          {
            "ingestToken": []
          },
          {
            "session": []
          },
          {
            "apiToken": []
          },
          {
            "adminToken": []
          }
        ],
        "description": "Finds the use of AWS key canaries by their access key ID. Takes a CloudTrail log file (`{ Records }`), the answer of `aws cloudtrail lookup-events` (`{ Events }`), EventBridge events (`{ detail }`) or plain events, alone or in an array, optionally gzipped, up to 32 MiB. An event sent again is kept once, by its eventID.\n\n```bash\naws cloudtrail lookup-events --lookup-attributes AttributeKey=AccessKeyId,AttributeValue=AKIA... --start-time \"$(date -u -d '-15 min' +%FT%TZ)\" \\\n  | curl -sf -X POST -H \"Authorization: Bearer $DECEPTION_INGEST_TOKEN\" -H 'content-type: application/json' --data-binary @- \\\n    https://deception.example.com/api/v1/cloudtrail\n```\n\nWith `DECEPTION_INGEST_TOKEN`, or an API token with the editor role.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {}
            }
          }
        },
        "responses": {
          "200": {
            "description": "What was found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrailResult"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "413": {
            "$ref": "#/components/responses/Problem"
          },
          "503": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
